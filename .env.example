# Telegram bot credentials only
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Public https URL of the Mini App (Telegram refuses plain http).
# The bot serves the app on WEBAPP_PORT; point this URL at that port.
# WEBAPP_URL=https://bot.example.com
# WEBAPP_PORT=8080

# Optional: initial values (saved to user_config.json when changed via bot)
# NUM_CASES=1
# NOTIFY_FROM_DATE=2026-06-01
# NOTIFY_BEFORE_DATE=2026-06-15
# POLL_INTERVAL_SECONDS=300
